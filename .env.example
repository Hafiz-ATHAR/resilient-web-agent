# Environment (development | testing | staging | production)
ENVIRONMENT=development

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=my-experiment
MLFLOW_TRACE_TIMEOUT_SECONDS=

# LLM API Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key

# LangSmith
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=your-project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local LLM name, e.g. "qwen-7b-chat" or "gemini-1.5-pro"
LOCAL_LLM=qwen-7b-chat

# CORS — comma-separated or JSON array, e.g. CORS_ORIGINS='["http://host1","http://host2"]'
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting
API_RATE_LIMIT=10/minute
API_RATE_LIMIT_READ=120/minute
LLM_MAX_CONCURRENCY=2
MAX_URLS_PER_JOB=20
